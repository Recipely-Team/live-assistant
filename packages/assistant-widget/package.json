{
  "name": "@live-assistant/widget",
  "version": "0.3.0",
  "description": "A ready-made voice assistant UI for React Native and the web: an orb that moves with the voices, a transcript and controls, themed and worded by the app. Built only on @live-assistant/react's public hooks.",
  "license": "MIT",
  "author": "Recep Tayyip Ekşi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Recipely-Team/live-assistant.git",
    "directory": "packages/assistant-widget"
  },
  "homepage": "https://github.com/Recipely-Team/live-assistant/tree/main/packages/assistant-widget#readme",
  "bugs": {
    "url": "https://github.com/Recipely-Team/live-assistant/issues"
  },
  "keywords": [
    "react-native",
    "ui",
    "voice-assistant",
    "widget",
    "orb",
    "realtime"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "!src/**/__tests__",
    "!src/**/__fixtures__"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@live-assistant/core": "0.3.0",
    "@live-assistant/react": "0.3.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76"
  }
}
