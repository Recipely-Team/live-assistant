{
  "name": "@live-assistant/token-server",
  "version": "0.3.4",
  "description": "Server-side helper that mints short-lived Gemini Live tokens with your system instruction, tools and voice baked in, so the API key never reaches a device.",
  "license": "MIT",
  "author": "Recep Tayyip Ekşi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Recipely-Team/live-assistant.git",
    "directory": "packages/assistant-token-server"
  },
  "homepage": "https://github.com/Recipely-Team/live-assistant/tree/main/packages/assistant-token-server#readme",
  "bugs": {
    "url": "https://github.com/Recipely-Team/live-assistant/issues"
  },
  "keywords": [
    "gemini",
    "gemini-live",
    "ephemeral-token",
    "server",
    "node",
    "ai"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "!src/**/__tests__",
    "!src/**/__fixtures__"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@live-assistant/core": "0.3.4"
  },
  "engines": {
    "node": ">=18"
  }
}
