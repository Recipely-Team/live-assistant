{
  "name": "@live-assistant/core",
  "version": "0.1.0",
  "description": "Provider-neutral ports for an in-app voice assistant: the session, its events, audio, and the result type they share.",
  "license": "MIT",
  "author": "Recep Tayyip Ekşi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Recipely-Team/live-assistant.git",
    "directory": "packages/assistant-core"
  },
  "homepage": "https://github.com/Recipely-Team/live-assistant/tree/main/packages/assistant-core#readme",
  "bugs": {
    "url": "https://github.com/Recipely-Team/live-assistant/issues"
  },
  "keywords": [
    "voice-assistant",
    "realtime",
    "voice",
    "speech",
    "ai",
    "headless"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "!src/**/__tests__",
    "!src/**/__fixtures__"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
