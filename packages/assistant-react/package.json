{
  "name": "@live-assistant/react",
  "version": "0.1.0",
  "description": "Headless React bindings for @live-assistant/core: session state, transcript, per-frame levels and tool registration — build any UI, or use @live-assistant/widget.",
  "license": "MIT",
  "author": "Recep Tayyip Ekşi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Recipely-Team/live-assistant.git",
    "directory": "packages/assistant-react"
  },
  "homepage": "https://github.com/Recipely-Team/live-assistant/tree/main/packages/assistant-react#readme",
  "bugs": {
    "url": "https://github.com/Recipely-Team/live-assistant/issues"
  },
  "keywords": [
    "react",
    "react-native",
    "hooks",
    "voice-assistant",
    "realtime",
    "headless"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "!src/**/__tests__"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@live-assistant/core": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
